pipeline {
    agent any

    environment {
        DOTNET_CLI_HOME = '/var/jenkins_home/.dotnet'
        DOTNET_SKIP_FIRST_TIME_EXPERIENCE = '1'
        DOTNET_NOLOGO = '1'
        PROJECT_PATH = 'Web/Web.csproj'
    }

    stages {
        stage('Checkout código fuente') {
            steps {
                echo "📥 Clonando repositorio desde GitHub..."
                checkout scm
                sh 'ls -R devops || true'
            }
        }

        stage('Detectar entorno') {
            steps {
                script {
                    def branch = env.BRANCH_NAME ?: 'develop'

                    switch (branch) {
                        case 'main':
                            env.ENVIRONMENT = 'production'
                            break
                        case 'staging':
                            env.ENVIRONMENT = 'staging'
                            break
                        case 'qa':
                            env.ENVIRONMENT = 'qa'
                            break
                        default:
                            env.ENVIRONMENT = 'develop'
                            break
                    }

                    env.ENV_DIR = "devops/${env.ENVIRONMENT}"
                    env.COMPOSE_FILE = "${env.ENV_DIR}/docker-compose.yml"
                    env.ENV_FILE = "${env.ENV_DIR}/.env.${env.ENVIRONMENT == 'develop' ? 'dev' : env.ENVIRONMENT}"

                    echo """
                    ✅ Rama detectada: ${branch}
                    🌎 Entorno asignado: ${env.ENVIRONMENT}
                    📄 Compose file: ${env.COMPOSE_FILE}
                    📁 Env file: ${env.ENV_FILE}
                    """

                    if (!fileExists(env.COMPOSE_FILE)) {
                        error "❌ No se encontró ${env.COMPOSE_FILE}"
                    }
                    if (!fileExists(env.ENV_FILE)) {
                        error "❌ No se encontró ${env.ENV_FILE}"
                    }
                }
            }
        }

        stage('Preparar red compartida') {
            steps {
                sh "docker network create codexy-network || true"
            }
        }

       stage('Levantar bases de datos (una sola vez)') {
            steps {
                dir('devops/databases') {
                    sh '''
                        echo "🚀 Levantando contenedor centralizado de bases de datos..."
                        # Usa -f para forzar el uso SOLO de este archivo
                        docker compose -f docker-compose.yml up -d --build
                        echo "⏳ Esperando 60 segundos para que las BDs se inicialicen..."
                        sleep 60
                    '''
                }
            }
        }

        stage('Migrar Base de Datos') {
            steps {
                script {
                    echo "🏗️ Ejecutando migraciones de Liquibase para ${env.ENVIRONMENT}..."

                    // --- Definir variables de conexión basadas en el entorno ---
                    def db_host = "codexy-mssql-${env.ENVIRONMENT}"
                    def db_name = "codexy_${env.ENVIRONMENT}"
                    def db_user = "sa"
                    def db_pass = ""

                    // Usamos las mismas contraseñas que están en tus docker-compose.yml de las DBs
                    switch (env.ENVIRONMENT) {
                        case 'develop':
                            db_pass = "Dev_P@ssw0rd_2025"
                            break
                        case 'qa':
                            db_pass = "Qa_P@ssw0rd_2025"
                            break
                        case 'staging':
                            db_pass = "Staging_P@ssw0rd_2025"
                            break
                        case 'production':
                            db_pass = "Prod_P@ssw0rd_2025"
                            break
                    }

                    // --- Ejecutar el contenedor de Liquibase ---
                    docker.image('liquibase/liquibase:latest')
                        .withRun(
                            // Conectar a la misma red que la base de datos
                            "--network=codexy-network " +
                            
                            // Montar la carpeta del driver que creamos
                            "-v ${PWD}/drivers:/liquibase/drivers " + 
                            
                            // Montar el workspace (donde está el db-changelog-master.xml)
                            "-v ${PWD}:/liquibase/workspace"
                        ) {
                        
                        // Esperar un poco más si la DB acaba de iniciar (opcional pero seguro)
                        sh "echo '...esperando 5s extra por la DB...' && sleep 5"
                        
                        // Ejecutar el comando Liquibase con todos los parámetros
                        sh """
                            liquibase --url="jdbc:sqlserver://${db_host}:1433;databaseName=${db_name};trustServerCertificate=true" \
                                      --username="${db_user}" \
                                      --password="${db_pass}" \
                                      --changeLogFile=./db-changelog-master.xml \
                                      --classpath=/liquibase/drivers/mssql-jdbc-12.6.1.jre11.jar \
                                      --driver=com.microsoft.sqlserver.jdbc.SQLServerDriver \
                                      update
                        """
                    }
                }
            }
        }

        stage('Compilar .NET') {
            steps {
                script {
                    docker.image('mcr.microsoft.com/dotnet/sdk:9.0')
                        .inside('-v /var/run/docker.sock:/var/run/docker.sock -u root:root') {
                        sh '''
                            echo "🔧 Restaurando dependencias .NET..."
                            dotnet restore Web/Web.csproj
                            dotnet build Web/Web.csproj --configuration Release
                            dotnet publish Web/Web.csproj -c Release -o ./publish
                        '''
                    }
                }
            }
        }

        stage('Construir imagen Docker') {
            steps {
                sh """
                    echo "🐳 Construyendo imagen Docker para codexy-api (${env.ENVIRONMENT})"
                    docker build -t codexy-api-${env.ENVIRONMENT}:latest -f Dockerfile .
                """
            }
        }

        stage('Desplegar backend') {
            steps {
                dir(env.ENV_DIR) {
                    sh """
                        echo "🚀 Desplegando backend: ${env.ENVIRONMENT}"
                        docker compose -f docker-compose.yml --env-file .env.${env.ENVIRONMENT == 'develop' ? 'dev' : env.ENVIRONMENT} up -d --build
                    """
                }
            }
        }
    }

    post {
        success {
            echo "🎉 Despliegue completado correctamente para ${env.ENVIRONMENT}"
        }
        failure {
            echo "💥 Error durante el despliegue en ${env.ENVIRONMENT}"
        }
        always {
            echo "🧹 Limpieza final del pipeline completada."
        }
    }
}
