<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-pedido-table" author="expo-team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="Pedido"/>
            </not>
        </preConditions>
        
        <createTable tableName="Pedido">
            <column name="Id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="Nombre" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="Apellido" type="varchar(255)"/>
            <column name="DeletedAt" type="datetime" defaultValueComputed="GETDATE()"/>
            <column name="CreatedAt" type="datetime" defaultValueComputed="GETDATE()"/>
        </createTable>

        <rollback>
            <dropTable tableName="Pedido"/>
        </rollback>
    </changeSet>
</databaseChangeLog>